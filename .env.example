# Inkloom AI Frontend Client Environment Configuration (Example Template)
# Copy this file to .env and configure with your Firebase Project Web App credentials.
# These values are public client identifiers bundled by Vite for the browser.
# DO NOT put Firebase private keys, database connection strings, or Supabase service-role keys in this file.
# Database and Supabase credentials belong strictly in backend/.env.

# Public Firebase Web App Configuration
VITE_FIREBASE_API_KEY=AIzaSyExamplePlaceholderApiKey
VITE_FIREBASE_AUTH_DOMAIN=inkloom-ai-example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=inkloom-ai-example
VITE_FIREBASE_STORAGE_BUCKET=inkloom-ai-example.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Custom backend API base URL (defaults to http://127.0.0.1:8000/api if omitted)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
