# Inkloom AI Backend Environment Configuration (Example Template)
# Copy this file to .env and configure real credentials if using live LLM features.
# NEVER commit .env to version control.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration
# Supported providers: "none" (demo/simulation mode), "gemini", "openai"
LLM_PROVIDER=none

# Server-side API Keys (Optional - only required if LLM_PROVIDER is not "none")
# Note: These keys are strictly read by the backend and never exposed to the frontend.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0

# Retrieval Configuration
SOURCES_DIR=backend/data/sources
MIN_CITATION_CONFIDENCE=80

# Firebase Admin Authentication Configuration (Server-Side Only)
# Never expose these server-side values to the frontend.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: Path to service account JSON file (e.g. backend/firebase-service-account.json)
FIREBASE_CREDENTIALS_PATH=
# Option B: Inline service account parameters (alternative for cloud container environments)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Require email verification before allowing access to verified-only features (default: true)
REQUIRE_EMAIL_VERIFIED=true
# Allow development simulation tokens (strictly rejected when ENVIRONMENT!=development or when set to false)
ALLOW_DEV_SIMULATION_TOKENS=true
# Rate limiting on authentication routes (requests per minute per client IP)
AUTH_RATE_LIMIT_PER_MINUTE=60

# Supabase PostgreSQL Database Configuration (Server-Side Only)
# Never expose the database connection string or service-role key to frontend code or Git.
#
# Direct Connection or Transaction Pooler URL from Supabase Project Settings -> Database:
# Format: postgresql+psycopg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct: postgresql+psycopg://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres
# When left blank, Inkloom AI safely defaults to a local persistent SQLite database for development/testing.
DATABASE_URL=

# Supabase Project Management Credentials (Server-Side Only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

